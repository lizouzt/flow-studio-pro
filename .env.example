# =================================================================
# Flow Studio Pro - 环境配置模板 (.env.example)
# 复制本文件为 .env 或 .env.local 即可自动生效，优先级高于 studio_config.js
# =================================================================

# 1. 阿里云百炼 API Key [必填]
# 获取地址: https://bailian.console.aliyun.com/
# 用于: 通义千问写稿/润色、CosyVoice 语音大模型配音、通义万相首帧生图与闭环视频动画、百炼 ASR
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 2. ASR 语音识别与时间戳对齐驱动模式 [推荐]
# 可选: "dashscope_asr" (百炼云端 ASR，推荐 qwen-audio-3.0-asr-flash) 
# 或   "faster_whisper" (本地 faster-whisper-server / OpenAI 兼容协议)
ASR_PROVIDER=dashscope_asr

# 3. 阿里云百炼 ASR 模型名称 [可选，仅当 ASR_PROVIDER=dashscope_asr 时生效]
# 推荐: qwen-audio-3.1-asr-flash-filetrans (官方旗舰非实时文件转写模型) 或 paraformer-v2
DASHSCOPE_ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans

# 4. faster-whisper-server / Whisper 服务端点 [可选，仅当 ASR_PROVIDER=faster_whisper 时生效]
# 采用兼容 OpenAI 标准协议格式 (POST /v1/audio/transcriptions)。
# 常见选项:
#  - 本地 faster-whisper-server: http://127.0.0.1:8000/v1/audio/transcriptions
#  - OpenAI 官方/第三方代理: https://api.openai.com/v1/audio/transcriptions
WHISPER_ENDPOINT_URL=http://127.0.0.1:8000/v1/audio/transcriptions

# 5. faster-whisper-server / Whisper 鉴权 Token [可选]
# 若自建端点无认证需求可留空；若使用官方或第三方服务请填入
WHISPER_API_KEY=

# 6. Web 服务启动端口 [可选]
PORT=3000
