# =================================================================
# Flow Studio Pro - 环境配置模板 (.env.example)
# 复制本文件为 .env 或 .env.local 即可自动生效，优先级高于 studio_config.js
# =================================================================

# 1. 阿里云百炼 API Key [必填]
# 获取地址: https://bailian.console.aliyun.com/
# 用于: 通义千问写稿/润色、CosyVoice 语音大模型配音、通义万相首帧生图与闭环视频动画
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 2. Whisper ASR 语音识别服务端点 [必填]
# 采用兼容 OpenAI 标准协议格式。
# 常见选项:
#  - 本地自建 Whisper API (免 Key): http://127.0.0.1:8000/v1/audio/transcriptions
#  - 官方或三方云端代理服务: https://api.openai.com/v1/audio/transcriptions
WHISPER_ENDPOINT_URL=http://127.0.0.1:8000/v1/audio/transcriptions

# 3. Whisper ASR 鉴权 Token [可选]
# 若自建端点无认证需求可留空；若使用官方或第三方服务请填入
WHISPER_API_KEY=

# 4. Web 服务启动端口 [可选]
PORT=3000
